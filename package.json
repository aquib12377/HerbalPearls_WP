{
  "name": "herbalpearls-wp",
  "version": "1.0.0",
  "private": true,
  "description": "Herbal Pearls — WordPress theme build pipeline (Tailwind CSS).",
  "scripts": {
    "build:css": "NODE_ENV=production tailwindcss -i ./assets/css/tailwind.src.css -o ./assets/css/tailwind.css --minify",
    "dev:css": "tailwindcss -i ./assets/css/tailwind.src.css -o ./assets/css/tailwind.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.13",
    "autoprefixer": "^10.4.19",
    "cssnano": "^7.0.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4"
  }
}
